# ====================================
# Watcher Environment Configuration
# ====================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ====================================
# API Keys
# ====================================

# Anthropic API Key (Required for summarization and vision analysis)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API Key (Optional - for cloud-based Whisper transcription)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Deepgram API Key (Optional - for enterprise-grade transcription)
# Get your key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ====================================
# Directory Paths
# ====================================

# Output directory for generated markdown files (default: ./output)
WATCHER_OUTPUT_DIR=./output

# Cache directory for downloaded videos and temp files (default: ./cache)
WATCHER_CACHE_DIR=./cache
