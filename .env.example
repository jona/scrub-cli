# Copy this template to the ignored .env.local file and set permissions to 0600.
# Set a nonempty server-only bearer token before starting the HTTP API/MCP host.
# Load it with: node --env-file=.env.local dist/deployments/local/api.js
SCRUB_API_TOKEN=

# Provider keys belong in a separate ignored, owner-only .env.models.local:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LANGSMITH_API_KEY=

# Node API/MCP host settings. Keep durable state on persistent storage.
SCRUB_DATA_DIR=.local/runtime
SCRUB_STAGING_ROOT=.local/staging
SCRUB_HOST=0.0.0.0
PORT=8080
SCRUB_TRANSCRIBERS=youtube-captions,faster-whisper
# SCRUB_PUBLIC_ORIGINS=http://localhost:8080
# SCRUB_PYTHON_PATH=python3
# SCRUB_RESOURCE_LIMITS={"maxDurationSeconds":21600,"maxAttempts":3}
# SCRUB_REQUEST_CONCURRENCY=1
# SCRUB_RUNNER_CONCURRENCY=2
# SCRUB_GLOBAL_CONCURRENCY=none
# Shared CLI/API/MCP model policy; public settings, separate from provider keys.
# SCRUB_MODEL_TIMEOUT_MS=600000
# SCRUB_SUMMARY_PROVIDER=openai
# SCRUB_SUMMARY_MODEL=gpt-6.1-sol
# SCRUB_VISION_PROVIDER=openai
# SCRUB_VISION_MODEL=gpt-6.1-terra
# SCRUB_INFERENCE_LIMITS={"initialOutputTokens":16384,"maxOutputTokens":32768,"outputTokenRetries":2}

# Optional server-side model tracing. Off until explicitly enabled.
# LANGSMITH_API_KEY stays with the separate ignored provider secret file above.
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=scrub
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# SCRUB_LANGSMITH_CAPTURE_CONTENT=false
# SCRUB_LANGSMITH_TIMEOUT_MS=2000
