# Copy this template to .env.rivet.local and set permissions to 0600.
# Replace reserved example destinations with your cluster's own URLs.
# Keep admin/server values in that ignored file or your secret manager.
RIVET_ENDPOINT=https://engine.example.invalid
RIVET_TOKEN=
RIVET_PUBLIC_URL=https://app.example.invalid

# Optional app HTTP bearer token. If unset, the runner uses RIVET_TOKEN.
# SCRUB_API_TOKEN=

# Provider keys belong in a separate ignored, owner-only .env.models.local:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LANGSMITH_API_KEY=

# Standalone API/MCP: configure these in an ignored .env.server.local file.
# SCRUB_API_TOKEN is required there; standalone hosts do not use RIVET_TOKEN.
# SCRUB_DATA_DIR=.local/runtime
# SCRUB_STAGING_ROOT=.local/staging
# SCRUB_HOST=0.0.0.0
# PORT=8080
# SCRUB_TRANSCRIBERS=youtube-captions,faster-whisper
# SCRUB_RESOURCE_LIMITS={"maxDurationSeconds":21600,"maxAttempts":3}
# Shared CLI/API/MCP model policy; public settings, separate from provider keys.
# SCRUB_MODEL_TIMEOUT_MS=600000
# SCRUB_INFERENCE_LIMITS={"initialOutputTokens":16384,"maxOutputTokens":32768,"outputTokenRetries":2}

# Optional server-side model tracing. Off until explicitly enabled.
# LANGSMITH_API_KEY stays with the separate ignored provider secret file above.
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=scrub
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
# SCRUB_LANGSMITH_CAPTURE_CONTENT=false
# SCRUB_LANGSMITH_TIMEOUT_MS=2000
