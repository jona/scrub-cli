{
  "name": "scrub-cli",
  "version": "0.3.0",
  "description": "Turn audio and video into deterministic, model-agnostic knowledge artifacts for AI agents.",
  "main": "dist/index.js",
  "bin": {
    "scrub": "dist/deployments/local/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jona/scrub-cli.git"
  },
  "homepage": "https://github.com/jona/scrub-cli#readme",
  "type": "module",
  "scripts": {
    "prebuild": "npm run clean",
    "postbuild": "chmod +x dist/deployments/local/cli.js",
    "prepack": "npm run build",
    "build": "tsc",
    "start": "node dist/deployments/local/cli.js",
    "dev": "tsx src/deployments/local/cli.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:e2e": "INCLUDE_E2E=1 vitest run",
    "test:coverage": "vitest run --coverage",
    "update:ytdlp:image": "node scripts/image/update-ytdlp.mjs",
    "typecheck:portable": "tsc -p tsconfig.portable.json --noEmit",
    "start:api": "node dist/deployments/local/api.js",
    "start:mcp": "node dist/deployments/local/mcp.js",
    "prebuild:image": "npm run update:ytdlp:image",
    "build:image": "docker buildx bake --file docker-bake.hcl"
  },
  "keywords": [
    "youtube",
    "video",
    "transcription",
    "markdown",
    "whisper",
    "artifacts",
    "agents",
    "claude-code"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@deepgram/sdk": "^5.18.0",
    "@modelcontextprotocol/server": "2.4.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "langsmith": "0.11.3",
    "openai": "^7.45.0",
    "react": "^18.3.1",
    "youtube-transcript": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "execa": "^9.6.1",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/entrypoints/cli/index.d.ts",
      "import": "./dist/entrypoints/cli/index.js"
    },
    "./api": {
      "types": "./dist/entrypoints/api/handler.d.ts",
      "import": "./dist/entrypoints/api/handler.js"
    },
    "./mcp": {
      "types": "./dist/entrypoints/mcp/index.d.ts",
      "import": "./dist/entrypoints/mcp/index.js"
    },
    "./local": {
      "types": "./dist/deployments/local/application.d.ts",
      "import": "./dist/deployments/local/application.js"
    }
  }
}
