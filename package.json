{
  "name": "scrub-cli",
  "version": "0.1.0",
  "description": "Turn videos to Agent Skills in seconds.",
  "main": "dist/entrypoints/cli/index.js",
  "bin": {
    "scrub": "./dist/entrypoints/cli/index.js",
    "scrub-mcp": "./dist/entrypoints/mcp/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jona/scrub-cli"
  },
  "homepage": "https://github.com/jona/scrub-cli#readme",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/entrypoints/cli/index.js",
    "dev": "tsx src/entrypoints/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:e2e": "vitest run --include-e2e",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "youtube",
    "video",
    "summarizer",
    "transcription",
    "markdown",
    "whisper",
    "claude",
    "mcp",
    "model-context-protocol",
    "claude-code"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@deepgram/sdk": "^3.9.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "openai": "^4.77.0",
    "ora": "^8.1.1",
    "react": "^18.3.1",
    "youtube-transcript": "^1.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "^4.0.18",
    "execa": "^9.6.1",
    "nock": "^14.0.10",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
